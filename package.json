		"redeploy:subscription": "hardhat run scripts/redeploy-subscription.ts --network kalychain",
		"rehearse:subscription": "KALYCHAIN_FORK=1 hardhat run scripts/rehearse-subscription.ts"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-toolbox": "^5.0.0",
		"@openzeppelin/contracts": "^5.6.1",
		"@types/node": "^20.19.43",
		"dotenv": "^16.6.1",
		"hardhat": "^2.29.1",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3"
	}
}
